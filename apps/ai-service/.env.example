NVIDIA_API_KEY=nvapi-xxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embed-v1

QDRANT_HOST=your-qdrant-host.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=aether
QDRANT_API_KEY=your-qdrant-api-key

WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
# Faster voice commands: greedy decoding + VAD. Raise concurrency only if the
# host has spare CPU cores (Whisper is CPU-bound and blocks a worker thread).
WHISPER_BEAM_SIZE=2
WHISPER_CONCURRENCY=1
WHISPER_VAD_FILTER=true
WHISPER_WARMUP=true
# 0 = let CTranslate2 choose; set to the container's CPU limit otherwise.
WHISPER_CPU_THREADS=0

# Enable provider-native JSON mode (OpenAI-compatible response_format).
# Leave off if your model/provider rejects response_format; JSON extraction
# still works via the parser fallback.
LLM_JSON_MODE=false
LLM_MAX_TOKENS=2048

SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=100
