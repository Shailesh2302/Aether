generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  files         File[]
  sessions      Session[]
  clips         Clip[]
  messages      Message[]
  jobs          Job[]
  subscription  Subscription?
  collections   Collection[]
  shareLinks    ShareLink[]
  savedSearches SavedSearch[]
  comments      Comment[]

  @@map("users")
}

model File {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  originalName  String
  mimeType      String
  size          BigInt
  path          String
  url           String?
  metadata      Json?
  tags          String[]  @default([])
  isFavorite    Boolean   @default(false)
  sourceUrl     String?

  status        FileStatus @default(PENDING)
  processingJob String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  clips         Clip[]
  collections   CollectionFile[]
  shareLinks    ShareLink[]
  comments      Comment[]

  @@index([userId])
  @@index([status])
  @@map("files")
}

enum FileStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId        String?
  file          File?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  
  title         String
  type          SessionType
  
  metadata      Json?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages      Message[]

  @@index([userId])
  @@index([fileId])
  @@map("sessions")
}

enum SessionType {
  CHAT
  SEARCH
  CLIP
  ANALYTICS
}

model Message {
  id            String    @id @default(uuid())
  sessionId     String
  session       Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role          MessageRole
  content       String
  metadata      Json?
  
  createdAt     DateTime  @default(now())

  @@index([sessionId])
  @@index([userId])
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Job {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type          JobType
  status        JobStatus @default(QUEUED)
  
  input         Json
  result        Json?
  error         String?
  
  progress      Int       @default(0)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("jobs")
}

enum JobType {
  VIDEO_PROCESSING
  DOCUMENT_PROCESSING
  CLIP_EXTRACTION
  VECTOR_INDEXING
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Clip {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId        String?
  file          File?     @relation(fields: [fileId], references: [id], onDelete: SetNull)

  title         String
  description   String?
  startTime     Float
  endTime       Float
  thumbnail     String?
  videoUrl      String?

  status        ClipStatus @default(PENDING)

  tags          String[]

  metadata      Json?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([fileId])
  @@map("clips")
}

enum ClipStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Collection {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  files         CollectionFile[]

  @@index([userId])
  @@map("collections")
}

model CollectionFile {
  id            String    @id @default(uuid())
  collectionId  String
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  fileId        String
  file          File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@unique([collectionId, fileId])
  @@index([fileId])
  @@map("collection_files")
}

model ShareLink {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId        String?
  file          File?     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  clipId        String?
  token         String    @unique
  expiresAt     DateTime?
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([fileId])
  @@map("share_links")
}

model SavedSearch {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  query         String
  lastCount     Int       @default(0)
  lastCheckedAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("saved_searches")
}

model Comment {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId        String
  file          File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  timestampSec  Float?
  text          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([fileId])
  @@map("comments")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan                 BillingPlan       @default(TRIAL)
  status               SubscriptionStatus @default(TRIALING)

  // 30-day free trial window (from account creation)
  trialEndsAt          DateTime

  // Current paid period (null while trialing / never subscribed)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?

  cancelAtPeriodEnd    Boolean            @default(false)

  // Stripe references
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@index([trialEndsAt])
  @@map("subscriptions")
}

enum BillingPlan {
  TRIAL
  PLAN_3_MONTH
  PLAN_6_MONTH
  PLAN_12_MONTH
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}